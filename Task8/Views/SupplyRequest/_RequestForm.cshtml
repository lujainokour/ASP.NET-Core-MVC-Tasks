@model RequestFormViewModel
<div asp-validation-summary="All" class="text-danger"></div>
<p>Enter a quantity for each product you need. Leave the others at zero.</p>
@if (Model.Products.Count == 0)
{
    <p>No products available. An administrator must add products first.</p>
}
else
{
    <div class="table-responsive">
        <table class="table table-bordered">
            <thead><tr><th>Product</th><th>Unit Price</th><th>Available</th><th>Requested Quantity</th></tr></thead>
            <tbody>
            @for (int i = 0; i < Model.Products.Count; i++)
            {
                <tr>
                    <td>
                        @Model.Products[i].Name
                        <input asp-for="Products[i].ProductId" type="hidden" />
                    </td>
                    <td>@Model.Products[i].Price.ToString("0.00")</td>
                    <td>@Model.Products[i].AvailableQuantity</td>
                    <td>
                        <input asp-for="Products[i].Quantity" type="number" min="0"
                               max="@Model.Products[i].AvailableQuantity" class="form-control"
                               aria-label="Quantity for @Model.Products[i].Name" />
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
    <button type="submit" class="btn btn-primary">Save Request</button>
}
<a asp-action="Index" class="btn btn-secondary">Back</a>
