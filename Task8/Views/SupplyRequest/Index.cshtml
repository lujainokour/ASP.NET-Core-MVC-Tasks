@model List<SupplyRequest>
@{
    ViewData["Title"] = "Supply Requests";
}
<h2>Supply Requests</h2>
<a asp-action="Create" class="btn btn-primary mb-3">Create Request</a>
@if (Model.Count == 0)
{
    <p>No requests yet.</p>
}
else
{
    <div class="table-responsive">
        <table class="table table-bordered">
            <thead><tr><th>Request</th><th>Date</th><th>Total Price</th><th>Status</th><th>Actions</th></tr></thead>
            <tbody>
            @foreach (var request in Model)
            {
                <tr>
                    <td>@request.Id</td>
                    <td>@request.RequestDate.ToString("yyyy-MM-dd HH:mm")</td>
                    <td>@request.TotalPrice.ToString("0.00")</td>
                    <td>@request.Status</td>
                    <td><a asp-action="Details" asp-route-id="@request.Id">Details</a></td>
                </tr>
            }
            </tbody>
        </table>
    </div>
}
