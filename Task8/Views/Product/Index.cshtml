@model List<Product>
@{
    ViewData["Title"] = "Products";
    bool canManage = User.IsInRole("Admin") || User.IsInRole("SuperAdmin");
}

<h2>Products</h2>
@if (canManage)
{
    <a asp-action="Create" class="btn btn-primary mb-3">Add Product</a>
}
@if (Model.Count == 0)
{
    <p>No products available.</p>
}
else
{
    <div class="table-responsive">
        <table class="table table-bordered">
            <thead><tr><th>Name</th><th>Price</th><th>Available Quantity</th><th>Actions</th></tr></thead>
            <tbody>
            @foreach (var product in Model)
            {
                <tr>
                    <td>@product.Name</td>
                    <td>@product.Price.ToString("0.00")</td>
                    <td>@product.Quantity</td>
                    <td>
                        <a asp-action="Details" asp-route-id="@product.Id">Details</a>
                        @if (canManage)
                        {
                            <a asp-action="Edit" asp-route-id="@product.Id" class="ms-2">Edit</a>
                            <a asp-action="Delete" asp-route-id="@product.Id" class="ms-2">Delete</a>
                        }
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
}
